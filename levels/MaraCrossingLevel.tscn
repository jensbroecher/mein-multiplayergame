[sub_resource type="Shader" id="Shader_h441r"]
code = "shader_type spatial;
void fragment() {
	float y = 1.0 - UV.y;
	float band = step(0.72, y) * step(y, 0.88);
	ALBEDO = mix(vec3(0.92, 0.90, 0.86), vec3(0.85, 0.08, 0.06), band);
	ROUGHNESS = 0.55;
	EMISSION = vec3(0.85, 0.08, 0.06) * band * 0.25;
}
"


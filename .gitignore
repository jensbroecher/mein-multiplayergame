# Godot 4+ specific ignores
.godot/
.godot/global_script_class_cache.cfg
.godot/imported/
.godot/uid_cache.bin

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (if you generate them via Godot)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific ignores
.DS_Store
Thumbs.db
*~
*.swp
*.bak
*.import
!materials/*.import
!materials/**/*.import
!sprites/*.import
!sprites/**/*.import
!images/*.import
!images/**/*.import
!sounds/*.import
!sounds/**/*.import
!music/*.import
!music/**/*.import
# The rock and plant models' textures import as streamed textures (scratch/stream_textures.py):
# their import settings have to travel with the project, or a fresh checkout imports them plain.
!models/plants/*.png.import
!models/desert/*.png.import
!models/desert2/*.png.import
!models/desert3/*.png.import
!models/desertridge/*.png.import
!models/trees/*.png.import
# The 3D logo's textures (scratch/logo_trace.gd writes their settings: lossless, the faces with mipmaps).
!generated/logo/*.png.import

# Large asset models and raw files
*.fbx
assets/models/
models/cars/*.fbx
models/desert/*.fbx
models/plants/*.fbx
models/ramps/*.fbx



